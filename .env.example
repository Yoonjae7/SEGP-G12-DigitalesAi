# --- AI provider ---------------------------------------------------------
# mock (default): written rules inside the app. llm: a real model (see lib/ai/providers/llm.ts).
AI_PROVIDER=mock
# Only needed when AI_PROVIDER=llm. Never prefix with NEXT_PUBLIC_.
# LLM_API_KEY=
# Demo only: chance (0 to 1) that the mock provider fails, to show the error state.
# MOCK_FAIL_RATE=0

# --- Team-only Lab view ----------------------------------------------------
# /lab?key=<LAB_KEY>. Choose a long random string.
LAB_KEY=change-me

# --- Presentation layers (flags) ------------------------------------------
NEXT_PUBLIC_VOICE=1
NEXT_PUBLIC_3D=1

# --- Optional log sink (off by default) ------------------------------------
# LOG_SINK_URL=

# --- Audio generation (local only, in .env.local, never on Vercel) ---------
# ELEVENLABS_API_KEY=
